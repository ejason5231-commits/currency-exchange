```xml
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_gold_prices_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/gold_prices"
        android:textSize="24sp"
        android:textColor="@color/light_blue"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_world_gold_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/world_gold_price"
        android:textSize="18sp"
        android:textColor="@color/light_blue"
        app:layout_constraintTop_toBottomOf="@id/tv_gold_prices_title"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tv_myanmar_gold_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/myanmar_gold_prices"
        android:textSize="20sp"
        android:textColor="@color/light_blue"
        app:layout_constraintTop_toBottomOf="@id/tv_world_gold_price"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tv_16_pae_yay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sixteen_pae_yay"
        android:textSize="16sp"
        android:textColor="@color/light_blue"
        app:layout_constraintTop_toBottomOf="@id/tv_myanmar_gold_title"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tv_15_pae_yay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/fifteen_pae_yay"
        android:textSize="16sp"
        android:textColor="@color/light_blue"
        app:layout_constraintTop_toBottomOf="@id/tv_16_pae_yay"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
```
